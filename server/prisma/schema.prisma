datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. TENANT MANAGEMENT
model Tenant {
  id           String    @id @default(uuid()) @db.Uuid
  businessName String    @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  users        User[]
  roles        Role[]
  products     Product[]
  services     Service[]
  customers    Customer[]
  invoices     Invoice[]

  @@map("tenants")
}

// 2. USER ENGINE (Employees & Owners)
model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid @map("tenant_id")
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  // The universal escape hatch for employee-specific extra info
  customFields Json      @default("{}") @map("custom_fields")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  invoices     Invoice[]

  // Ensures email is unique ONLY within the same business tenant
  @@unique([tenantId, email])
  @@map("users")
}

// 3. ROLE-BASED ACCESS CONTROL (RBAC)
model Role {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid @map("tenant_id")
  name            String           @db.VarChar(50)
  description     String?          @db.Text

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100) // e.g., "create"
  resource        String           @db.VarChar(100) // e.g., "products"
  description     String?          @db.Text

  rolePermissions RolePermission[]

  @@unique([name, resource])
  @@map("permissions")
}

// Junction Tables using ON DELETE CASCADE to automatically clean up assignments
model UserRole {
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Protects core system permissions from accidental cascading deletions
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 4. CORE OPERATIONAL MODULES
model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid @map("tenant_id")
  name               String        @db.VarChar(255)
  sku                String?       @db.VarChar(100)
  costPrice          Decimal       @map("cost_price") @db.Decimal(12, 2)
  sellingPrice       Decimal       @map("selling_price") @db.Decimal(12, 2)
  stockQuantity      Int           @default(0) @map("stock_quantity")
  discountPercentage Decimal       @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  isOnSale           Boolean       @default(true) @map("is_on_sale")
  createdAt          DateTime      @default(now()) @map("created_at")
  
  customFields       Json          @default("{}") @map("custom_fields")

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems       InvoiceItem[]

  @@map("products")
}

model Service {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid @map("tenant_id")
  name         String        @db.VarChar(255)
  basePrice    Decimal       @map("base_price") @db.Decimal(12, 2)
  durationMin  Int           @map("duration_minutes")
  isAvailable  Boolean       @default(true) @map("is_available")
  createdAt    DateTime      @default(now()) @map("created_at")
  
  customFields Json          @default("{}") @map("custom_fields")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@map("services")
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid @map("tenant_id")
  mobileNumber String    @map("mobile_number") @db.VarChar(20)
  fullName     String    @map("full_name") @db.VarChar(255)
  address      String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  
  customFields Json      @default("{}") @map("custom_fields")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([tenantId, mobileNumber])
  @@map("customers")
}

// 5. BILLING ENGINE (Header-Detail Structure)
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid @map("tenant_id")
  customerId    String        @db.Uuid @map("customer_id")
  createdBy     String        @db.Uuid @map("created_by")
  invoiceNumber String        @map("invoice_number") @db.VarChar(50)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(12, 2)
  discountTotal Decimal       @map("discount_total") @db.Decimal(12, 2)
  totalPayable  Decimal       @map("total_payable") @db.Decimal(12, 2)
  status        String        @db.VarChar(20) // "PAID", "PENDING", "REFUNDED"
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items         InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid @map("invoice_id")
  productId String?  @db.Uuid @map("product_id")
  serviceId String?  @db.Uuid @map("service_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}
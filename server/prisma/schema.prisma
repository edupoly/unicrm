datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. TENANT MANAGEMENT
model Tenant {
  id           String     @id @default(uuid()) @db.Uuid
  businessName String     @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  users        User[]
  roles        Role[]
  items        Item[]     // Unified reference to all company offerings
  customers    Customer[]
  invoices     Invoice[]

  @@map("tenants")
}

// 2. USER ENGINE (Employees & Owners)
model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid @map("tenant_id")
  name         String     @db.VarChar(255)
  mobileNumber String     @map("mobile_number") @db.VarChar(20)
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  
  customFields Json       @default("{}") @map("custom_fields")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  invoices     Invoice[]

  @@unique([tenantId, email])
  @@unique([tenantId, mobileNumber])
  @@map("users")
}

// 3. ROLE-BASED ACCESS CONTROL (RBAC)
model Role {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid @map("tenant_id")
  name            String           @db.VarChar(50)
  description     String?          @db.Text

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  resource        String           @db.VarChar(100)
  description     String?          @db.Text

  rolePermissions RolePermission[]

  @@unique([name, resource])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 4. CORE OPERATIONAL MODULES (Inheritance Architecture)

enum ItemType {
  PRODUCT
  SERVICE
}

// Parent table carrying the foundational, financial, and analytical data
model Item {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid @map("tenant_id")
  name               String       @db.VarChar(255)
  sku                String?      @db.VarChar(100)
  basePrice          Decimal      @map("base_price") @db.Decimal(12, 2)
  itemType           ItemType     @map("item_type")
  createdAt          DateTime     @default(now()) @map("created_at")
  customFields       Json         @default("{}") @map("custom_fields")

  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceItems       InvoiceItem[]
  
  // 1:1 Extended Relations
  productDetails     ProductDetail?
  serviceDetails     ServiceDetail?

  @@unique([tenantId, sku]) // Ensures SKU uniqueness per tenant when provided
  @@index([tenantId, itemType]) // Index for fast dashboard performance counters
  @@map("items")
}

// Child table holding details unique strictly to physical items
model ProductDetail {
  itemId             String       @id @db.Uuid @map("item_id")
  costPrice          Decimal      @map("cost_price") @db.Decimal(12, 2)
  stockQuantity      Int          @default(0) @map("stock_quantity")
  discountPercentage Decimal      @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  isOnSale           Boolean      @default(true) @map("is_on_sale")
  
  // Product-specific metadata (e.g., {"weight": "2kg", "dimensions": "10x10x10"})
  customFields       Json         @default("{}") @map("custom_fields")

  item               Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("product_details")
}

// Child table holding details unique strictly to time/delivery services
model ServiceDetail {
  itemId             String       @id @db.Uuid @map("item_id")
  durationMin        Int          @map("duration_minutes")
  isAvailable        Boolean      @default(true) @map("is_available")
  
  // Service-specific metadata (e.g., {"travel_required": true, "skills": ["nodejs"]})
  customFields       Json         @default("{}") @map("custom_fields")

  item               Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model Customer {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid @map("tenant_id")
  mobileNumber String     @map("mobile_number") @db.VarChar(20)
  fullName     String     @map("full_name") @db.VarChar(255)
  address      String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  
  customFields Json       @default("{}") @map("custom_fields")

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([tenantId, mobileNumber])
  @@map("customers")
}

// 5. BILLING ENGINE (Clean & Line-Item Agnostic)
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid @map("tenant_id")
  customerId    String        @db.Uuid @map("customer_id")
  createdBy     String        @db.Uuid @map("created_by")
  invoiceNumber String        @map("invoice_number") @db.VarChar(50)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(12, 2)
  discountTotal Decimal       @map("discount_total") @db.Decimal(12, 2)
  totalPayable  Decimal       @map("total_payable") @db.Decimal(12, 2)
  status        String        @db.VarChar(20) // "PAID", "PENDING", "REFUNDED"
  createdAt     DateTime      @default(now()) @map("created_at")
  customFields   Json         @default("{}") @map("custom_fields")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items         InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @db.Uuid @map("invoice_id")
  itemId     String?  @db.Uuid @map("item_id") // Completely unified relation pointer
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(12, 2)

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item       Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  
  @@unique([invoiceId, itemId]) // Enforces uniqueness while keeping a separate row ID
  @@map("invoice_items")
}
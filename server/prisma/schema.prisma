datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. TENANT MANAGEMENT
model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  businessName String   @map("business_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customFields Json @default("{}") @map("custom_fields")

  users     User[]
  roles     Role[]
  items     Item[] // Unified reference to all company offerings
  customers Customer[]
  invoices  Invoice[]

  tenantConfig TenantConfig? // 1:1 relation reference

  @@map("tenants")
}

model TenantConfig {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @unique @map("tenant_id") @db.Uuid
  businessType String @map("business_type") @db.VarChar(255)

  // UI Customizations
  productLabelPlural    String @default("Products") @map("product_label_plural") @db.VarChar(50)
  productLabelSingular  String @default("Product") @map("product_label_singular") @db.VarChar(50)
  serviceLabelPlural    String @default("Services") @map("service_label_plural") @db.VarChar(50)
  serviceLabelSingular  String @default("Service") @map("service_label_singular") @db.VarChar(50)
  customerLabelPlural   String @default("Customers") @map("customer_label_plural") @db.VarChar(50)
  customerLabelSingular String @default("Customer") @map("customer_label_singular") @db.VarChar(50)

  // Localization & Region
  currencyCode String @default("INR") @map("currency_code") @db.VarChar(10)
  timeZone     String @default("Asia/Kolkata") @map("time_zone") @db.VarChar(100)

  // JSON Blobs for Schema Extensions & Custom Layouts
  customFields    Json @default("{}") @map("custom_fields")
  billingSettings Json @default("{}") @map("billing_settings")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_configs")
}

// 2. USER ENGINE (Employees & Owners)
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(255)
  mobileNumber String   @map("mobile_number") @db.VarChar(20)
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  customFields Json @default("{}") @map("custom_fields")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  invoices         Invoice[]
  createdItems     Item[]     @relation("ItemCreator")
  updatedItems     Item[]     @relation("ItemUpdater")
  createdCustomers Customer[] @relation("CustomerCreator")
  updatedCustomers Customer[] @relation("CustomerUpdater")

  @@unique([tenantId, email])
  @@unique([tenantId, mobileNumber])
  @@map("users")
}

// 3. ROLE-BASED ACCESS CONTROL (RBAC)
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String  @db.VarChar(50)
  description String? @db.Text

  customFields Json @default("{}") @map("custom_fields")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  resource    String  @db.VarChar(100)
  description String? @db.Text

  customFields Json @default("{}") @map("custom_fields")

  rolePermissions RolePermission[]

  @@unique([name, resource])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// 4. CORE OPERATIONAL MODULES (Inheritance Architecture)

enum ItemType {
  PRODUCT
  SERVICE
}

// Parent table carrying foundational, financial, and analytical data
model Item {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  name     String   @db.VarChar(255)
  sku      String?  @db.VarChar(100)
  price    Decimal  @map("price") @db.Decimal(12, 2)
  itemType ItemType @map("item_type")

  // 🌟 Moved up to the Parent table so Services can also have promotions!
  discountPercentage Decimal @default(0.00) @map("discount_percentage") @db.Decimal(5, 2)
  isOnSale           Boolean @default(true) @map("is_on_sale")

  // 🌟 AUDIT FIELDS
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  customFields Json @default("{}") @map("custom_fields")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator      User?         @relation("ItemCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater      User?         @relation("ItemUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  invoiceItems InvoiceItem[]

  // 1:1 Extended Relations
  productDetails ProductDetail?
  serviceDetails ServiceDetail?

  @@unique([tenantId, sku]) // Ensures SKU uniqueness per tenant when provided
  @@index([tenantId, itemType]) // Index for fast dashboard performance counters
  @@map("items")
}

// Child table holding details unique strictly to physical items
model ProductDetail {
  itemId            String  @id @map("item_id") @db.Uuid
  costPrice         Decimal @map("cost_price") @db.Decimal(12, 2)
  stockQuantity     Int     @default(0) @map("stock_quantity")
  minimumStockLevel Int     @default(5) @map("minimum_stock_level") // 🌟 Added for low-stock warning dashboards

  // Product-specific metadata (e.g., {"weight": "2kg", "dimensions": "10x10x10"})
  customFields Json @default("{}") @map("custom_fields")
  item         Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("product_details")
}

// Child table holding details unique strictly to time/delivery services
model ServiceDetail {
  itemId      String  @id @map("item_id") @db.Uuid
  durationMin Int     @map("duration_minutes")
  isAvailable Boolean @default(true) @map("is_available")

  // Service-specific metadata (e.g., {"travel_required": true, "skills": ["nodejs"]})
  customFields Json @default("{}") @map("custom_fields")
  item         Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model Customer {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  mobileNumber String  @map("mobile_number") @db.VarChar(20)
  fullName     String  @map("full_name") @db.VarChar(255)
  address      String? @db.Text

  // 🌟 AUDIT FIELDS
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  customFields Json @default("{}") @map("custom_fields")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  User?     @relation("CustomerCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?     @relation("CustomerUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([tenantId, mobileNumber])
  @@map("customers")
}

// 5. BILLING ENGINE (Clean & Line-Item Agnostic)
model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  createdBy     String   @map("created_by") @db.Uuid
  invoiceNumber String   @map("invoice_number") @db.VarChar(50)
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @map("tax_amount") @db.Decimal(12, 2)
  discountTotal Decimal  @map("discount_total") @db.Decimal(12, 2)
  totalPayable  Decimal  @map("total_payable") @db.Decimal(12, 2)
  status        String   @db.VarChar(20) // "PAID", "PENDING", "REFUNDED"
  createdAt     DateTime @default(now()) @map("created_at")
  customFields  Json     @default("{}") @map("custom_fields")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user     User          @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id         String  @id @default(uuid()) @db.Uuid
  invoiceId  String  @map("invoice_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid // Completely unified relation pointer
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  customFields Json @default("{}") @map("custom_fields")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, itemId]) // Enforces uniqueness while keeping a separate row ID
  @@map("invoice_items")
}
